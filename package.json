  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^8.57.0",
    "eslint-plugin-playwright": "^2.2.0",
    "globals": "^17.12.0"
  }
